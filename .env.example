# Caption Studio Frontend - Environment Variables Configuration Template
# Place root/frontend configurations here during local development.

# URL pointing to the deployed Express backend on Render
VITE_API_URL=https://your-backend-render-domain.onrender.com

# Maximum number of media-processing jobs allowed at once.
MAX_CONCURRENT_JOBS=2

# Where the bundled sound-effect assets are served from. Defaults to the app's
# own static root (public/sounds/), which is all localhost development needs.
# Point this at object storage/a CDN to serve them from elsewhere — no editor
# code changes, since every consumer resolves sounds through
# shared/soundRegistry.js rather than by path.
# VITE_SOUNDS_BASE_URL=https://cdn.example.com/caption-studio/sounds
